{
    "name": "extension",
    "private": true,
    "version": "0.0.52",
    "type": "module",
    "scripts": {
        "build": "npm run build:inpage && cp dist_inpage/inpage.js inpage.js && vite build --config vite-config/chrome.ts",
        "build:inpage": "vite build --config vite-config/chrome.inpage.config.ts",
        "build:test": "npm run build:inpage && cp dist_inpage/inpage.js inpage.js && vite build --config vite-config/chrome.ts --mode development",
        "build:chrome": "npm run build:inpage && cp dist_inpage/inpage.js inpage.js && vite build --config vite-config/chrome.ts",
        "build:firefox": "vite build --config vite-config/firefox.ts",
        "dev": "nodemon --config nodemon/chrome.json",
        "dev:chrome": "nodemon --config nodemon/chrome.json",
        "dev:firefox": "nodemon --config nodemon/firefox.json",
        "lint": "eslint .",
        "preview": "vite preview",
        "extension:dev": "node ../scripts/chrome-extension-dev.js",
        "extension:build": "npm run build && node ../scripts/chrome-extension-publish.js",
        "pack": "./script/pack.cjs"
    },
    "dependencies": {
        "@types/crypto-js": "^4.2.2",
        "copy-text-to-clipboard": "^3.2.0",
        "crypto-js": "^4.2.0",
        "dompurify": "^3.2.6",
        "ethers": "^6.14.4",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "momentjs": "^2.0.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router-dom": "^7.6.2",
        "sealx-core": "^1.0.14",
        "sealx-message": "^1.0.17",
        "zustand": "^5.0.6"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.0.2",
        "@eslint/js": "^9.29.0",
        "@tailwindcss/postcss": "^4.1.10",
        "@tailwindcss/vite": "^4.1.10",
        "@types/chrome": "^0.0.326",
        "@types/lodash": "^4.17.24",
        "@types/node": "^24.0.4",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.5.2",
        "autoprefixer": "^10.4.21",
        "chrome-webstore-upload-cli": "^3.5.0",
        "eslint": "^9.29.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.2.0",
        "nodemon": "^3.1.10",
        "playwright": "^1.60.0",
        "rollup-plugin-copy": "^3.5.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.34.1",
        "vite": "^6.0.0",
        "vite-plugin-svgr": "^4.3.0",
        "vite-tsconfig-paths": "^5.1.4"
    }
}

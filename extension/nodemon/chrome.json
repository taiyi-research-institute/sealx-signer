{
    "env": {
        "__DEV__": "true"
    },
    "watch": [
        "./src",
        "./vite-config/base.ts",
        "./vite-config/chrome.ts",
        "./manifest/manifest.json"
    ],
    "ext": "tsx,css,html,ts,json",
    "ignore": ["./src/**/*.spec.ts"],
    "exec": "vite build --config ./vite-config/chrome.inpage.config.ts && vite build --config ./vite-config/chrome.ts --mode development"
}

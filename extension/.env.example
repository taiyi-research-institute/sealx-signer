# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and will override .env.

# PIN hashing salt — used by popup to hash PIN before sending to background SW
VITE_SEALX_KEY=change-me-to-a-random-hex-string
# PBKDF2 salt — used in deriveHMACKeyFromPIN for HMAC key derivation
VITE_PBKDF2_SALT=change-me-to-another-random-hex-string

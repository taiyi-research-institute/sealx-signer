{
    "references": [{ "path": "../sealx-core" }],
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "module": "preserve",
        "moduleResolution": "bundler",
        "baseUrl": "./src",
        "declaration": true,
        "declarationDir": "dist",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "paths": {
            "sealx-core": ["../sealx-core/src"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}

{
    "type": "module",
    "name": "sealx-sdk",
    "version": "1.0.33",
    "description": "JavaScript/TypeScript SDK for interacting with the SealX browser extension",
    "keywords": [
        "sealx",
        "sdk",
        "digital-signature",
        "eip712",
        "browser-extension",
        "web3"
    ],
    "license": "MIT",
    "author": "Zoran Wong",
    "repository": {
        "type": "git",
        "url": "https://github.com/taiyi-research-institute/sealx-signer.git",
        "directory": "packages/sealx-sdk"
    },
    "homepage": "https://github.com/taiyi-research-institute/sealx-signer#readme",
    "bugs": {
        "url": "https://github.com/taiyi-research-institute/sealx-signer/issues"
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c",
        "prepublishOnly": "npm run build",
        "test": "echo \"No tests specified\""
    },
    "dependencies": {
        "@types/aes-js": "^3.1.4",
        "rxjs": "^7.8.2",
        "sealx-core": "^1.0.13",
        "sealx-message": "^1.0.18"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-typescript": "^12.1.4",
        "rollup": "^4.45.1",
        "rollup-plugin-dts": "^6.2.1",
        "typescript": "^5.8.3"
    }
}

{
    "type": "module",
    "name": "sealx-core",
    "version": "1.0.13",
    "description": "Core library for SealX digital signature system",
    "keywords": [
        "sealx",
        "signature",
        "eip712",
        "digital-signature",
        "cryptography"
    ],
    "license": "MIT",
    "author": "Zoran Wong",
    "repository": {
        "type": "git",
        "url": "https://github.com/taiyi-research-institute/sealx-signer.git",
        "directory": "packages/sealx-core"
    },
    "homepage": "https://github.com/taiyi-research-institute/sealx-signer#readme",
    "bugs": {
        "url": "https://github.com/taiyi-research-institute/sealx-signer/issues"
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        },
        "./exceptions/*": {
            "types": "./dist/exceptions/*.d.ts",
            "import": "./dist/exceptions/*.mjs",
            "require": "./dist/exceptions/*.cjs"
        }
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "build": "rollup -c",
        "prepublishOnly": "npm run build",
        "test": "echo \"No tests specified\""
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-typescript": "^12.1.4",
        "@types/chrome": "^0.0.326",
        "@types/crypto-js": "^4.2.2",
        "@types/lodash": "^4.17.20",
        "@types/webextension-polyfill": "^0.10.0",
        "rollup": "^4.45.1",
        "rollup-plugin-dts": "^6.2.1",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "crypto-js": "^4.2.0",
        "ethers": "^6.14.3",
        "lodash": "^4.17.21",
        "webextension-polyfill": "^0.10.0"
    }
}

{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "sealx-core": ["./packages/sealx-core/src"],
            "sealx-message": ["./packages/sealx-message/src"]
        },
        "outDir": "dist"
    },
    "include": ["packages"],
    "exclude": ["node_modules"]
}
